generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CrawlStatus {
  QUEUED
  RUNNING
  PAUSED
  PARTIAL
  COMPLETED
  FAILED
}

enum CrawlUrlStatus {
  DISCOVERED
  PROCESSING
  PROCESSED
  ERROR
  EXCLUDED
  SKIPPED
}

enum TemplateStatus {
  SAMPLING
  SAMPLED
  MIXED
}

enum ResponseKind {
  HTML
  REDIRECT
  NON_HTML
  ERROR
}

enum Severity {
  CRITICAL
  WARNING
  INFO
}

model Crawl {
  id                String      @id @default(cuid())
  ownerHash         String?
  shares            ReportShare[]
  verifications     FixVerification[]
  scheduleId        String?
  schedule          CrawlSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  notificationCheckedAt DateTime?
  rootUrl           String
  normalizedHost    String
  status            CrawlStatus @default(QUEUED)
  progress          Int         @default(0)
  processedPages    Int         @default(0)
  discoveredPages   Int         @default(0)
  statusMessage     String      @default("Tarama sıraya alındı")
  error             String?
  analyzedHtmlPages Int         @default(0)
  redirectCount     Int         @default(0)
  pendingUrls       Int         @default(0)
  errorUrls         Int         @default(0)
  partialReason     String?
  score             Int?
  fullCrawl         Boolean     @default(false)
  skippedUrls       Int         @default(0)
  checkedRules      Json?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime    @default(now())
  pages             Page[]
  findings          Finding[]
  exclusions        Exclusion[]
  crawlUrls         CrawlUrl[]
  urlTemplates      UrlTemplate[]
  aiAnalyses        AiAnalysis[]

  @@index([normalizedHost, createdAt])
  @@index([ownerHash, normalizedHost, createdAt])
}

enum AiAnalysisStatus {
  IDLE
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model AiAnalysis {
  id          String           @id @default(cuid())
  crawlId     String
  crawl       Crawl            @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  locale      String
  status      AiAnalysisStatus @default(IDLE)
  generation  String           @default("")
  result      Json?
  model       String?
  error       String?
  generatedAt DateTime?
  updatedAt   DateTime         @updatedAt
  createdAt   DateTime         @default(now())

  @@unique([crawlId, locale])
}

model Page {
  id             String       @id @default(cuid())
  crawlId        String
  crawl          Crawl        @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  url            String
  statusCode     Int?
  responseKind   ResponseKind @default(HTML)
  redirectTarget String?
  contentType    String?
  title          String?
  description    String?
  canonical      String?
  robots         String?
  h1             Json?
  headings       Json?
  images         Json?
  textContent    String?
  contentHash    String?
  links          Json?
  hreflangs      Json?
  jsonLd         Json?
  redirectChain  Json?
  lang           String?
  viewport       String?
  socialTags     Json?
  mixedContent   Json?
  structure      Json?
  rendered      Boolean      @default(false)
  error          String?
  depth          Int          @default(0)
  createdAt      DateTime     @default(now())

  @@unique([crawlId, url])
}

model CrawlUrl {
  id          String         @id @default(cuid())
  crawlId     String
  crawl       Crawl          @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  url         String
  normalized  String
  status      CrawlUrlStatus @default(DISCOVERED)
  depth       Int            @default(0)
  sourceUrl   String?
  fromSitemap Boolean        @default(false)
  linked      Boolean        @default(false)
  lastError   String?
  attempts    Int            @default(0)
  template    String?
  updatedAt   DateTime       @updatedAt
  createdAt   DateTime       @default(now())

  @@unique([crawlId, normalized])
  @@index([crawlId, status, createdAt])
  @@index([crawlId, template])
}

// Otomatik tespit edilen URL şablonu; örneklerin yapısı benzemiyorsa MIXED olur ve tamamı analiz edilir.
model UrlTemplate {
  id         String         @id @default(cuid())
  crawlId    String
  crawl      Crawl          @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  pattern    String
  status     TemplateStatus @default(SAMPLING)
  similarity Float?
  createdAt  DateTime       @default(now())

  @@unique([crawlId, pattern])
}

model Finding {
  id             String   @id @default(cuid())
  crawlId        String
  crawl          Crawl    @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  code           String
  severity       Severity
  title          String
  description    String
  recommendation String
  fingerprint    String
  affectedUrls   Json
  evidence       Json
  createdAt      DateTime @default(now())

  @@index([crawlId, severity])
  @@index([crawlId, code])
}

model Exclusion {
  id      String @id @default(cuid())
  crawlId String
  crawl   Crawl  @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  url     String
  reason  String
}

model ReportShare {
  id        String @id @default(cuid())
  crawlId   String
  crawl     Crawl @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([crawlId])
}

model FixVerification {
  id String @id @default(cuid())
  crawlId String
  crawl Crawl @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  code String
  targets Json
  status String @default("QUEUED")
  generation String
  checkedAt DateTime?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  @@unique([crawlId, code])
}

model CrawlSchedule {
  id String @id @default(cuid())
  ownerHash String
  normalizedHost String
  rootUrl String
  fullCrawl Boolean @default(false)
  frequency String
  enabled Boolean @default(true)
  nextRunAt DateTime
  lastRunAt DateTime?
  crawls Crawl[]
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  @@unique([ownerHash, normalizedHost])
  @@index([enabled, nextRunAt])
}
model NotificationEvent {
  id String @id @default(cuid())
  ownerHash String
  normalizedHost String
  crawlId String @unique
  type String
  payload Json
  deliveredAt DateTime?
  createdAt DateTime @default(now())
  @@index([deliveredAt, createdAt])
}

model ContactRequest {
  id String @id @default(cuid())
  ownerHash String
  email String
  subject String
  message String
  handledAt DateTime?
  createdAt DateTime @default(now())
  @@index([handledAt, createdAt])
}
